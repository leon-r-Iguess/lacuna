{
  "name": "lacuna",
  "version": "0.5.3",
  "description": "Obsidian plugin that finds the gaps in your knowledge: AI-generated quizzes from your notes, PDFs and images, with scoring, error analysis and exam readiness.",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p . && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "version": "node version-bump.mjs",
    "smoke": "node scripts/smoke.cjs dist/main.js"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "learning",
    "quiz",
    "spaced-repetition",
    "fsrs",
    "ai"
  ],
  "author": "Leon",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.2"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
